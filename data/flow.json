  "faqBank": [
    {
      "tag": "sede",
      "q": "¿Dónde quedan? (sede)",
      "a": "“Estamos en Bogotá. Te comparto la ubicación exacta por WhatsApp y te cuento opciones de parqueo.”"
    },
    {
      "tag": "como-funciona",
      "q": "¿Cómo funcionan las clases?",
      "a": "“Te recomendamos empezar con un plan mensual. Depende de edad, objetivo y disponibilidad.”"
    },
    {
      "tag": "precio",
      "q": "¿Por qué vale lo que vale? (precio)",
      "a": "“Incluye acompañamiento real, metodología artística, docentes seleccionados y seguimiento. No es solo ‘dar clase’, es formar.”"
    },
    {
      "tag": "horarios",
      "q": "¿Tienen horarios flexibles?",
      "a": "“Buscamos el horario que mejor se ajuste. Te propongo 2 opciones según tu disponibilidad.”"
    },
    {
      "tag": "virtual",
      "q": "¿Tienen clases virtuales?",
      "a": "“Sí. Virtual funciona muy bien si hay constancia y objetivos claros. Te explico cómo sería el proceso.”"
    },
    {
      "tag": "edad",
      "q": "¿Desde qué edad reciben?",
      "a": "“Tenemos opciones por edades. Cuéntame la edad exacta y el objetivo para recomendarte lo ideal.”"
    }
  ],
