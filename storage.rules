rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function autorizado() {
      return request.auth != null && request.auth.token.email in [
        'alekcaballeromusic@gmail.com',
        'catalina.medina.leal@gmail.com',
        'musicalaasesor@gmail.com',
        'imusicala@gmail.com'
      ];
    }

    function admin() {
      return request.auth != null && request.auth.token.email in [
        'alekcaballeromusic@gmail.com',
        'catalina.medina.leal@gmail.com'
      ];
    }

    // Futuras notas de voz/audios de respuestas predeterminadas.
    // El equipo autorizado puede escucharlas/descargarlas; solo admins suben o borran.
    match /respuestas-predeterminadas-audios/{allPaths=**} {
      allow read: if autorizado();
      allow create, update: if admin()
        && request.resource != null
        && request.resource.size < 25 * 1024 * 1024
        && request.resource.contentType.matches('audio/.*');
      allow delete: if admin();
    }
  }
}
