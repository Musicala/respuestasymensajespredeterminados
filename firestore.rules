rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Correos autorizados a entrar
    function autorizado() {
      return request.auth != null && request.auth.token.email in [
        'alekcaballeromusic@gmail.com',
        'catalina.medina.leal@gmail.com',
        'musicalaasesor@gmail.com',
        'imusicala@gmail.com'
      ];
    }

    // Solo Alek y Cata pueden editar
    function admin() {
      return request.auth != null && request.auth.token.email in [
        'alekcaballeromusic@gmail.com',
        'catalina.medina.leal@gmail.com'
      ];
    }

    // Conocimiento: todo el equipo lee, solo admins escriben
    match /conocimiento/{doc} {
      allow read: if autorizado();
      allow write: if admin();
    }

    // Pendientes: todo el equipo puede crear, solo admins gestionan/leen
    match /pendientes/{doc} {
      allow create: if autorizado();
      allow read, update, delete: if admin();
    }

    // Respuestas predeterminadas: colección aislada para esta herramienta.
    // Todo el equipo puede consultar; solo admins crean, editan, archivan e importan.
    match /respuestasPredeterminadas/{doc} {
      allow read: if autorizado();
      allow create, update, delete: if admin();
    }
  }
}
