rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Solo Alek y Cata administran las demás colecciones del proyecto.
    function adminGeneral() {
      return request.auth != null && request.auth.token.email in [
        'alekcaballeromusic@gmail.com',
        'catalina.medina.leal@gmail.com'
      ];
    }

    // Estos cuatro correos administran exclusivamente los mensajes predeterminados.
    function editorMensajes() {
      return request.auth != null && request.auth.token.email in [
        'alekcaballeromusic@gmail.com',
        'catalina.medina.leal@gmail.com',
        'musicalaasesor@gmail.com',
        'adminmusicala@gmail.com'
      ];
    }

    match /conocimiento/{doc} {
      allow read, write: if adminGeneral();
    }

    match /pendientes/{doc} {
      allow read, write: if adminGeneral();
    }

    match /respuestasPredeterminadas/{doc} {
      allow read, create, update, delete: if editorMensajes();
    }
  }
}
